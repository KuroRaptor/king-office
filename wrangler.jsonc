{
  // King Office · configuración de Cloudflare
  // Cloudflare lee este archivo cada vez que se publica desde GitHub.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "king-office",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "king-office",
      "database_id": "fd2dd705-7cd9-4925-b1d4-48bd2916697a"
    }
  ],
  // limpieza diaria de salas viejas (09:00 UTC = 3:00 a. m. en Honduras)
  "triggers": { "crons": ["0 9 * * *"] },
  "observability": { "enabled": true }
}
